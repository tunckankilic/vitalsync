// VitalSync — DEVELOPMENT Amplify configuration TEMPLATE.
//
// The real `lib/amplifyconfiguration.dart` is generated by the Amplify CLI
// (`amplify pull`) and is git-ignored on purpose. This placeholder template is
// committed so a fresh clone knows the expected shape and key names.
//
// To set up locally: run the Amplify CLI against the dev environment, or copy
// this file to `lib/amplifyconfiguration.dart` and fill in the real dev values.
//
// Loaded by default and whenever the app is built with `--dart-define=ENV=dev`
// (see lib/core/config/app_environment.dart).
const amplifyconfig = '''{
    "UserAgent": "aws-amplify-cli/2.0",
    "Version": "1.0",
    "analytics": {
        "plugins": {
            "awsPinpointAnalyticsPlugin": {
                "pinpointAnalytics": {
                    "appId": "<DEV_PINPOINT_APP_ID>",
                    "region": "<DEV_REGION>"
                },
                "pinpointTargeting": {
                    "region": "<DEV_REGION>"
                }
            }
        }
    },
    "api": {
        "plugins": {
            "awsAPIPlugin": {
                "vitalsynchApi": {
                    "endpointType": "REST",
                    "endpoint": "https://<DEV_API_ID>.execute-api.<DEV_REGION>.amazonaws.com/dev",
                    "region": "<DEV_REGION>",
                    "authorizationType": "AWS_IAM"
                }
            }
        }
    },
    "auth": {
        "plugins": {
            "awsCognitoAuthPlugin": {
                "UserAgent": "aws-amplify-cli/0.1.0",
                "Version": "0.1.0",
                "IdentityManager": {
                    "Default": {}
                },
                "CredentialsProvider": {
                    "CognitoIdentity": {
                        "Default": {
                            "PoolId": "<DEV_IDENTITY_POOL_ID>",
                            "Region": "<DEV_REGION>"
                        }
                    }
                },
                "CognitoUserPool": {
                    "Default": {
                        "PoolId": "<DEV_USER_POOL_ID>",
                        "AppClientId": "<DEV_APP_CLIENT_ID>",
                        "Region": "<DEV_REGION>"
                    }
                },
                "Auth": {
                    "Default": {
                        "authenticationFlowType": "USER_SRP_AUTH",
                        "socialProviders": [
                            "SIGN_IN_WITH_APPLE"
                        ],
                        "usernameAttributes": [
                            "EMAIL"
                        ],
                        "signupAttributes": [
                            "EMAIL"
                        ],
                        "passwordProtectionSettings": {
                            "passwordPolicyMinLength": 8,
                            "passwordPolicyCharacters": []
                        },
                        "mfaConfiguration": "OFF",
                        "mfaTypes": [
                            "SMS"
                        ],
                        "verificationMechanisms": [
                            "EMAIL"
                        ],
                        "OAuth": {
                            "WebDomain": "<DEV_OAUTH_DOMAIN>.auth.<DEV_REGION>.amazoncognito.com",
                            "AppClientId": "<DEV_APP_CLIENT_ID>",
                            "SignInRedirectURI": "site.tunckankilic.vitalsync://callback/",
                            "SignOutRedirectURI": "site.tunckankilic.vitalsync://signout/",
                            "Scopes": [
                                "email",
                                "openid",
                                "profile",
                                "aws.cognito.signin.user.admin"
                            ]
                        }
                    }
                },
                "DynamoDBObjectMapper": {
                    "Default": {
                        "Region": "<DEV_REGION>"
                    }
                },
                "PinpointAnalytics": {
                    "Default": {
                        "AppId": "<DEV_PINPOINT_APP_ID>",
                        "Region": "<DEV_REGION>"
                    }
                },
                "PinpointTargeting": {
                    "Default": {
                        "Region": "<DEV_REGION>"
                    }
                }
            }
        }
    },
    "storage": {
        "plugins": {
            "awsDynamoDbStoragePlugin": {
                "partitionKeyName": "PK",
                "sortKeyName": "SK",
                "sortKeyType": "S",
                "region": "<DEV_REGION>",
                "arn": "arn:aws:dynamodb:<DEV_REGION>:<DEV_ACCOUNT_ID>:table/vitalsynchDBtable-dev",
                "streamArn": "arn:aws:dynamodb:<DEV_REGION>:<DEV_ACCOUNT_ID>:table/vitalsynchDBtable-dev/stream/<DEV_STREAM_LABEL>",
                "partitionKeyType": "S",
                "name": "vitalsynchDBtable-dev"
            }
        }
    }
}''';
